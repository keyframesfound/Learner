# Copy to .env. Never commit .env.
POSTGRES_PASSWORD=change-me-long-random
AUTH_SECRET=change-me-32-bytes-min
BETTER_AUTH_URL=https://ai.ssc.edu.hk
SITE_ADDRESS=ai.ssc.edu.hk

# Google SSO — create an OAuth client in the sscasr project.
# Authorised redirect URI: https://ai.ssc.edu.hk/learner/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# local development
DATABASE_URL=postgres://learner:change-me-long-random@localhost:5432/learner
